<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_google_places" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.google.places</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Google Places API Integration">
                    <setting string="Enable Google Places Address Autocomplete"
                        help="Provide address autocomplete functionality using Google Places API">
                        <field name="google_places_enabled" />
                        <div class="content-group" invisible="not google_places_enabled">
                            <div class="row mt16">
                                <label for="google_places_api_key"
                                    string="Google Places API Key"
                                    class="col-3 col-lg-3 o_light_label" />
                                <field name="google_places_api_key"
                                    placeholder="Enter your Google Places API key"
                                    password="True" />
                            </div>
                            <div class="row">
                                <label for="google_places_country_restriction"
                                    string="Country Restriction"
                                    class="col-3 col-lg-3 o_light_label" />
                                <field name="google_places_country_restriction" />
                            </div>
                            <div class="row">
                                <label for="google_places_usage_limit"
                                    string="Monthly Usage Limit"
                                    class="col-3 col-lg-3 o_light_label" />
                                <field name="google_places_usage_limit" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
