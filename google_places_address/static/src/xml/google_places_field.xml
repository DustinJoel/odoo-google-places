<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="google_places_address.GooglePlacesField">
        <div class="o_field_google_places_autocomplete">
            <input
                type="text"
                t-ref="googlePlacesInput"
                class="o_input o_field_google_places_search"
                t-att-placeholder="props.placeholder || '🌍 Type to search for an address...'"
                t-att-disabled="!state.initialized"
                t-on-focus="() => this.ensureInitialized()"
                autocomplete="off"
            />
            <div t-if="state.isLoading" class="o_field_google_places_loading text-muted small">
                <i class="fa fa-spinner fa-spin"/> Loading Google Places...
            </div>
            <div t-if="state.error" class="o_field_google_places_error text-danger small">
                <i class="fa fa-exclamation-triangle"/> <t t-esc="state.error"/>
            </div>
        </div>
    </t>

</templates>
