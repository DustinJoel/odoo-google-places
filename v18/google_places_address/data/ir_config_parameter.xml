<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Google Places API default configuration -->
        <!-- Note: These are just default templates. The actual configuration -->
        <!-- is done per-company through Settings > General Settings -->
        
        <!-- Default monthly usage limit -->
        <record id="google_places_default_usage_limit" model="ir.config_parameter">
            <field name="key">google.places.default_usage_limit</field>
            <field name="value">1000</field>
        </record>
        
        <!-- Default country restriction (empty = no restriction) -->
        <record id="google_places_default_country" model="ir.config_parameter">
            <field name="key">google.places.default_country</field>
            <field name="value"></field>
        </record>
        
    </data>
</odoo>
